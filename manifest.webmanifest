{
  "name": "Erun — Errands, Handled.",
  "short_name": "Erun",
  "description": "A vetted, professional errand-running marketplace — one app, one wallet, one runner, multiple stops.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0C1B30",
  "theme_color": "#122843",
  "lang": "en-AU",
  "dir": "ltr",
  "categories": ["lifestyle", "shopping", "productivity"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Book an errand",
      "short_name": "Book",
      "description": "Start a new errand from the home screen",
      "url": ".?screen=book",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Track my errand",
      "short_name": "Activity",
      "description": "See what's in progress right now",
      "url": ".?screen=activity",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Erun wallet",
      "short_name": "Wallet",
      "description": "Balance, holds and transactions",
      "url": ".?screen=wallet",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
